<Project DefaultTargets="Package">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <PluginRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..'))</PluginRoot>
    <ProviderProject>$(PluginRoot)src/Jellyfin.Plugin.Database.Npgsql/Jellyfin.Plugin.Database.Npgsql.csproj</ProviderProject>
    <PackagingProject>$(PluginRoot)tools/Jellyfin.Plugin.Database.Npgsql.Packaging/Jellyfin.Plugin.Database.Npgsql.Packaging.csproj</PackagingProject>
    <PackagingTool>$(PluginRoot)tools/Jellyfin.Plugin.Database.Npgsql.Packaging/bin/$(Configuration)/net10.0/Jellyfin.Plugin.Database.Npgsql.Packaging.dll</PackagingTool>
    <ArtifactsDirectory>$(PluginRoot)artifacts/</ArtifactsDirectory>
    <PublishDirectory>$(ArtifactsDirectory)publish/</PublishDirectory>
    <PackageDirectory>$(ArtifactsDirectory)package/</PackageDirectory>
    <SymbolsDirectory>$(ArtifactsDirectory)symbols/</SymbolsDirectory>
    <PackagePath>$(ArtifactsDirectory)jellyfin-plugin-database-npgsql_0.1.0.0.zip</PackagePath>
    <PackageChecksumPath>$(PackagePath).sha256</PackageChecksumPath>
    <SymbolPath>$(SymbolsDirectory)Jellyfin.Plugin.Database.Npgsql.pdb</SymbolPath>
    <SymbolChecksumPath>$(SymbolPath).sha256</SymbolChecksumPath>
  </PropertyGroup>

  <Target Name="CleanPackage">
    <RemoveDir Directories="$(ArtifactsDirectory)" />
    <MakeDir Directories="$(PublishDirectory);$(PackageDirectory);$(SymbolsDirectory)" />
  </Target>

  <Target Name="BuildPackagingTool">
    <MSBuild
      Projects="$(PackagingProject)"
      Targets="Build"
      Properties="Configuration=$(Configuration);RestoreLockedMode=true" />
  </Target>

  <Target Name="PublishPlugin" DependsOnTargets="BuildPackagingTool;CleanPackage">
    <MSBuild
      Projects="$(ProviderProject)"
      Targets="Publish"
      Properties="Configuration=$(Configuration);PublishDir=$(PublishDirectory);RestoreLockedMode=true" />
  </Target>

  <Target Name="Package" DependsOnTargets="PublishPlugin">
    <ItemGroup>
      <PackageArtifact Include="$(PublishDirectory)Jellyfin.Plugin.Database.Npgsql.dll" />
      <PackageArtifact Include="$(PublishDirectory)Jellyfin.Plugin.Database.Npgsql.deps.json" />
      <PackageArtifact Include="$(PublishDirectory)Npgsql.EntityFrameworkCore.PostgreSQL.dll" />
      <PackageArtifact Include="$(PublishDirectory)Npgsql.dll" />
      <PackageArtifact Include="$(PublishDirectory)meta.json" />
      <PackageArtifact Include="$(PublishDirectory)LICENSE" />
      <PackageArtifact Include="$(PublishDirectory)THIRD-PARTY-NOTICES.md" />

    </ItemGroup>

    <Error
      Condition="!Exists('%(PackageArtifact.Identity)')"
      Text="Required plugin artifact is missing: %(PackageArtifact.Identity)" />
    <Copy SourceFiles="@(PackageArtifact)" DestinationFolder="$(PackageDirectory)" />
    <Copy
      SourceFiles="$(PublishDirectory)Jellyfin.Plugin.Database.Npgsql.pdb"
      DestinationFolder="$(SymbolsDirectory)" />
    <Exec
      Command="dotnet &quot;$(PackagingTool)&quot; verify-symbols &quot;$(PublishDirectory)Jellyfin.Plugin.Database.Npgsql.dll&quot; &quot;$(SymbolPath)&quot;" />
    <ItemGroup>
      <StagedArtifact Include="$(PackageDirectory)*" />
      <ForbiddenHostAssembly Include="$(PackageDirectory)Jellyfin.Database.Implementations.dll" Condition="Exists('$(PackageDirectory)Jellyfin.Database.Implementations.dll')" />
      <ForbiddenHostAssembly Include="$(PackageDirectory)MediaBrowser.*.dll" />
      <ForbiddenHostAssembly Include="$(PackageDirectory)Microsoft.EntityFrameworkCore*.dll" />
      <ForbiddenHostAssembly Include="$(PackageDirectory)Microsoft.Extensions.*.dll" />
      <UnexpectedArtifact Include="@(StagedArtifact)" Exclude="@(PackageArtifact->'$(PackageDirectory)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Error
      Condition="'@(ForbiddenHostAssembly)' != ''"
      Text="Host-owned runtime assemblies must not be packaged: @(ForbiddenHostAssembly, ', ')" />
    <Error
      Condition="'@(UnexpectedArtifact)' != ''"
      Text="The staged package contains an artifact outside the release allowlist: @(UnexpectedArtifact, ', ')" />
    <Touch Files="@(StagedArtifact)" Time="2000-01-01T00:00:00Z" />
    <Touch Files="$(SymbolPath)" Time="2000-01-01T00:00:00Z" />
    <Exec Command="dotnet &quot;$(PackagingTool)&quot; &quot;$(PackageDirectory)&quot; &quot;$(PackagePath)&quot;" />
    <GetFileHash Files="$(PackagePath)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="PackageHash" />
    </GetFileHash>
    <WriteLinesToFile
      File="$(PackageChecksumPath)"
      Lines="%(PackageHash.FileHash)  $([System.IO.Path]::GetFileName('$(PackagePath)'))"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
    <GetFileHash Files="$(SymbolPath)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="SymbolHash" />
    </GetFileHash>
    <WriteLinesToFile
      File="$(SymbolChecksumPath)"
      Lines="%(SymbolHash.FileHash)  $([System.IO.Path]::GetFileName('$(SymbolPath)'))"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
    <Touch Files="$(PackageChecksumPath)" Time="2000-01-01T00:00:00Z" />
    <Touch Files="$(SymbolChecksumPath)" Time="2000-01-01T00:00:00Z" />
    <Message Importance="high" Text="Created $(PackagePath)" />
    <Message Importance="high" Text="Created checksums for the package and bound portable symbols in $(SymbolsDirectory)" />
  </Target>
</Project>
