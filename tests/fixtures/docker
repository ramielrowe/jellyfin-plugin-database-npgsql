#!/usr/bin/env python3
"""Deterministic Docker CLI double for stale-container reaper regressions."""

import fcntl
import os
import pathlib
import sys

scope = os.environ["FAKE_DOCKER_SCOPE"]
scenario = os.environ["FAKE_DOCKER_SCENARIO"]
state_path = pathlib.Path(os.environ["FAKE_DOCKER_STATE"])
log_path = pathlib.Path(os.environ["FAKE_DOCKER_LOG"])
container_id = "a" * 64
second_id = "b" * 64
lease = "20261009000000-123-" + "d" * 32
name = "jellyfin-npgsql-smoke-" + lease


def row(identifier=container_id, container_name=name, lease_id=lease):
    return f"{identifier}|{container_name}|true|{scope}|{lease_id}|123|456"


state_path.touch(mode=0o600, exist_ok=True)
with state_path.open("r+") as state:
    fcntl.flock(state, fcntl.LOCK_EX)
    removed = state.read().strip() == "removed"
    arguments = sys.argv[1:]
    if arguments[:1] == ["ps"]:
        if not removed:
            if scenario == "malformed":
                print("not-an-id|malformed")
            elif scenario == "duplicate":
                print(row())
                print(row(second_id, "jellyfin-npgsql-smoke-" + lease, lease))
            else:
                print(row())
        raise SystemExit(0)

    if arguments[:1] == ["inspect"]:
        requested = arguments[-1]
        if requested != container_id or scenario == "disappeared" or removed:
            print(f"Error: No such object: {requested}", file=sys.stderr)
            raise SystemExit(1)
        print(f"{container_id}|/{name}|true|{scope}|{lease}|123|456")
        raise SystemExit(0)

    if arguments[:2] == ["rm", "--force"]:
        requested = arguments[-1]
        if requested != container_id or removed:
            print(f"Error: No such container: {requested}", file=sys.stderr)
            raise SystemExit(1)
        state.seek(0)
        state.truncate()
        state.write("removed")
        state.flush()
        with log_path.open("a") as log:
            log.write(requested + "\n")
        print(requested)
        raise SystemExit(0)

print("unsupported fake docker invocation: " + " ".join(sys.argv[1:]), file=sys.stderr)
raise SystemExit(2)
