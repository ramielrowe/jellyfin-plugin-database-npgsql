<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Jellyfin.Plugin.Database.Npgsql</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.Database.Npgsql</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <DefineConstants>$(DefineConstants);NPGSQL_PREDECESSOR_FIXTURE</DefineConstants>
    <Version>0.0.9.0</Version>
    <AssemblyVersion>0.0.9.0</AssemblyVersion>
    <FileVersion>0.0.9.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile
      Include="../../../src/Jellyfin.Plugin.Database.Npgsql/**/*.cs"
      Exclude="../../../src/Jellyfin.Plugin.Database.Npgsql/bin/**;../../../src/Jellyfin.Plugin.Database.Npgsql/obj/**;../../../src/Jellyfin.Plugin.Database.Npgsql/Migrations/20261009113458_AddUuidMinMaxAggregates.cs;../../../src/Jellyfin.Plugin.Database.Npgsql/Migrations/20261009113458_AddUuidMinMaxAggregates.Designer.cs" />
  </ItemGroup>

  <ItemGroup Label="Host-provided compile contracts">
    <PackageReference Include="Jellyfin.Database.Implementations" ExcludeAssets="runtime" Private="false" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" ExcludeAssets="runtime" Private="false" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" ExcludeAssets="runtime" Private="false" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" ExcludeAssets="runtime" Private="false" />
  </ItemGroup>

  <ItemGroup Label="Plugin-shipped runtime dependencies">
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup Label="Build analyzers">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="SerilogAnalyzer" PrivateAssets="all" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" PrivateAssets="all" />
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="meta.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../LICENSE" CopyToOutputDirectory="PreserveNewest" Link="LICENSE" />
    <None Include="../../../THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" Link="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>
</Project>
