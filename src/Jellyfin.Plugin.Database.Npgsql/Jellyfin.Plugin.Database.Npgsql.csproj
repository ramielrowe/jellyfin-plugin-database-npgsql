<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Jellyfin.Plugin.Database.Npgsql</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.Database.Npgsql</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
  </PropertyGroup>

  <ItemGroup Label="Host-provided compile contracts">
    <PackageReference Include="Jellyfin.Controller" ExcludeAssets="runtime" Private="false" />
    <PackageReference Include="Jellyfin.Database.Implementations" ExcludeAssets="runtime" Private="false" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" ExcludeAssets="runtime" Private="false" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" ExcludeAssets="runtime" Private="false" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" ExcludeAssets="runtime" Private="false" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" ExcludeAssets="runtime" Private="false" />
  </ItemGroup>

  <ItemGroup Label="Plugin-shipped runtime dependencies">
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup Label="Build analyzers">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="SerilogAnalyzer" PrivateAssets="all" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" PrivateAssets="all" />
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="LICENSE" />
    <None Include="../../meta.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="meta.json" />
    <None Include="../../THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

  <ItemGroup Condition="'$(PackagingFailureMigration)' == 'true'">
    <Compile Include="../../tests/fixtures/ForcedFailureMigration.cs" Link="Migrations/ForcedFailureMigration.cs">
      <AutoGen>true</AutoGen>
      <DesignTime>true</DesignTime>
    </Compile>
  </ItemGroup>
</Project>
